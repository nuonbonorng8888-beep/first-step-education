rules_version = '2';

// Worksheet.Kh — student accounts & results
// Paste this whole file into: Firebase console → Firestore Database → Rules → Publish
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myDoc() { return /databases/$(database)/documents/users/$(request.auth.uid); }
    function me() { return get(myDoc()).data; }
    function hasProfile() { return signedIn() && exists(myDoc()); }
    function isAdmin() { return hasProfile() && me().role == 'admin'; }
    function isTeacher() { return hasProfile() && me().role in ['teacher', 'admin']; }
    function isActiveStudent() { return hasProfile() && me().role == 'student' && me().active == true; }

    // ---------- people ----------
    match /users/{uid} {
      allow read: if signedIn() && (
        request.auth.uid == uid ||
        isAdmin() ||
        (isTeacher() && resource.data.teacherUid == request.auth.uid)
      );

      // Admin creates teachers; teachers create students in their own classes
      allow create: if isAdmin() || (
        isTeacher() &&
        request.resource.data.role in ['student', 'scoreeditor'] &&
        request.resource.data.teacherUid == request.auth.uid &&
        (request.resource.data.role == 'student' ||
          get(/databases/$(database)/documents/classes/$(request.resource.data.editClassId)).data.teacherUid == request.auth.uid)
      );

      allow update: if isAdmin() || (
        isTeacher() &&
        resource.data.teacherUid == request.auth.uid &&
        request.resource.data.role == resource.data.role &&
        request.resource.data.role in ['student', 'scoreeditor'] &&
        request.resource.data.teacherUid == request.auth.uid
      );

      allow delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      // Student's own Box Calculation summary (totals, medals, best levels)
      match /meta/{docId} {
        allow read: if signedIn() && (
          request.auth.uid == uid ||
          isAdmin() ||
          (isTeacher() && get(/databases/$(database)/documents/users/$(uid)).data.teacherUid == request.auth.uid)
        );
        allow write: if request.auth.uid == uid && isActiveStudent();
      }

      // Student's own copy of results
      match /results/{rid} {
        allow create: if request.auth.uid == uid && isActiveStudent() &&
          request.resource.data.uid == uid;
        allow read: if signedIn() && (
          request.auth.uid == uid ||
          isAdmin() ||
          (isTeacher() && get(/databases/$(database)/documents/users/$(uid)).data.teacherUid == request.auth.uid)
        );
      }
    }

    // ---------- teacher roster (login screen list) ----------
    // Public read: the login screen needs the names before anyone logs in.
    // PINs are stored only as a hash here; the plain PIN is admin-only.
    match /roster/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /rosterPins/{id} {
      allow read, write: if isAdmin();
    }

    // ---------- teacher usage summaries ----------
    // Written by PIN-teacher devices (no Firebase login), so writes are only
    // allowed in a strict shape: one doc per teacher per day, small increases.
    match /teacherUsage/{docId} {
      allow read: if isAdmin();

      allow create: if request.resource.data.keys().hasOnly(['teacherId', 'teacherName', 'date', 'uses', 'minutes', 'exams', 'lastAt'])
        && request.resource.data.teacherId is string && request.resource.data.teacherId.size() <= 40
        && request.resource.data.date is string && request.resource.data.date.size() == 10
        && docId == request.resource.data.teacherId + '_' + request.resource.data.date
        && request.resource.data.teacherName is string
        && request.resource.data.teacherName.size() > 0 && request.resource.data.teacherName.size() <= 80
        && request.resource.data.uses is int && request.resource.data.uses >= 0 && request.resource.data.uses <= 5
        && request.resource.data.minutes is int && request.resource.data.minutes >= 0 && request.resource.data.minutes <= 10
        && request.resource.data.exams is int && request.resource.data.exams >= 0 && request.resource.data.exams <= 5
        && request.resource.data.lastAt == request.time;

      allow update: if request.resource.data.diff(resource.data).affectedKeys().hasOnly(['uses', 'minutes', 'exams', 'lastAt'])
        && request.resource.data.uses is int
        && request.resource.data.uses >= resource.data.uses && request.resource.data.uses <= resource.data.uses + 5
        && request.resource.data.minutes is int
        && request.resource.data.minutes >= resource.data.minutes && request.resource.data.minutes <= resource.data.minutes + 10
        && request.resource.data.exams is int
        && request.resource.data.exams >= resource.data.exams && request.resource.data.exams <= resource.data.exams + 5
        && request.resource.data.lastAt == request.time;
    }

    // ---------- classes ----------
    match /classes/{cid} {
      allow read: if isAdmin() ||
        (isTeacher() && resource.data.teacherUid == request.auth.uid) ||
        (isActiveStudent() && me().classId == cid);

      allow create: if isTeacher() && request.resource.data.teacherUid == request.auth.uid;
      allow update, delete: if isAdmin() || (isTeacher() && resource.data.teacherUid == request.auth.uid);

      // ---------- activity scores (ពិន្ទុសកម្មភាព) ----------
      // Teacher/admin: full control. Class leader: edits only after signing in with
      // the separate edit password (an account with role 'scoreeditor' that the
      // teacher created); allowed while the month is not locked.
      // Other students: read only their own row.
      function classTeacher(cid) {
        return isAdmin() || (isTeacher() &&
          get(/databases/$(database)/documents/classes/$(cid)).data.teacherUid == request.auth.uid);
      }
      function classMember(cid) { return isActiveStudent() && me().classId == cid; }
      function classEditor(cid) {
        return hasProfile() && me().role == 'scoreeditor' && me().active == true && me().editClassId == cid;
      }

      match /months/{mid} {
        allow read: if classTeacher(cid) || classMember(cid) || classEditor(cid);
        allow create, update, delete: if classTeacher(cid);

        match /rows/{rid} {
          allow read: if classTeacher(cid) || classEditor(cid) ||
            (classMember(cid) && (request.auth.uid == rid ||
              get(/databases/$(database)/documents/classes/$(cid)).data.get('scoreShare', false) == true));
          allow create, delete: if classTeacher(cid);
          allow update: if classTeacher(cid) || (
            classEditor(cid) &&
            get(/databases/$(database)/documents/classes/$(cid)/months/$(mid)).data.locked != true &&
            request.resource.data.diff(resource.data).affectedKeys().hasOnly(['s', 'byName', 'at'])
          );
        }

        // audit trail: teacher/leader may add entries, only teacher/admin may read
        match /log/{lid} {
          allow read: if classTeacher(cid);
          allow create: if classTeacher(cid) || classEditor(cid);
        }
      }

      // ---------- MCQ exams ----------
      // Questions carry only a hash of the right answer. The key (answers) is
      // readable by students only after the exam ended. A student can create
      // their result once, only inside the exam window; teachers may adjust it.
      match /exams/{eid} {
        function ex() { return get(/databases/$(database)/documents/classes/$(cid)/exams/$(eid)).data; }
        allow read: if classTeacher(cid) || classMember(cid);
        allow create, update, delete: if classTeacher(cid);

        match /key/{kid} {
          allow read: if classTeacher(cid) || (classMember(cid) && request.time > ex().endAt);
          allow write: if classTeacher(cid);
        }

        match /results/{uid} {
          allow read: if classTeacher(cid) || (classMember(cid) && request.auth.uid == uid);
          allow create: if classMember(cid) && request.auth.uid == uid
            && request.resource.data.uid == uid
            && request.time >= ex().startAt
            && request.time <= ex().endAt + duration.value(45, 's')
            && request.resource.data.score is number
            && request.resource.data.score >= 0
            && request.resource.data.score <= ex().total;
          allow update, delete: if classTeacher(cid);
        }
      }

      // Class copy of results, read by the class teacher
      match /results/{rid} {
        allow create: if isActiveStudent() &&
          me().classId == cid &&
          request.resource.data.uid == request.auth.uid;
        allow read: if isAdmin() ||
          (isTeacher() && get(/databases/$(database)/documents/classes/$(cid)).data.teacherUid == request.auth.uid);
      }
    }
  }
}
